# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║                                                                           ║
# ║   ⚠  NEVER COMMIT A REAL .env FILE. NEVER PUT A REAL KEY IN THIS FILE.   ║
# ║                                                                           ║
# ║   This is .env.example — a committed TEMPLATE with placeholder values.     ║
# ║   `.env` is listed in .gitignore and must stay there.                      ║
# ║                                                                           ║
# ║   Real values live in exactly two places:                                  ║
# ║     • Render  → Environment          (every API secret)                    ║
# ║     • Vercel  → Environment Variables (NEXT_PUBLIC_API_URL only)           ║
# ║                                                                           ║
# ║   If a key is ever committed: ROTATE IT FIRST, then rewrite history.       ║
# ║   Rotating is the fix; deleting the commit is housekeeping.                ║
# ║                                                                           ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
#
# Usage:
#   cp .env.example .env      # then fill in the real values
#
# Notes on syntax: KEY=value, one per line, no spaces around `=`, no quotes
# unless the value itself contains them, no trailing comments on a value line.
#
# You do NOT need this file to run the local Docker stack —
# `docker compose -f deploy/docker-compose.yml up` runs the API in mock mode with
# everything it needs already set. This file is for running the API directly
# (uvicorn) and as the reference list for what to paste into Render and Vercel.
# See deploy/runbook.md.


# ═══════════════════════════════════════════════════════════════════════════
# API (FastAPI) — server-side only. Nothing in this section may ever be
# prefixed NEXT_PUBLIC_ or referenced from browser code.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Engine ────────────────────────────────────────────────────────────────
# mock | live
#   mock — every analysis returns a fixture from data/fixtures/ after
#          MOCK_DELAY_SECONDS. No LLM calls, no database writes, no keys needed.
#          This is the default for local development and for the demo fallback.
#   live — calls engine.normalize/*, engine.ingest/*, engine.match/*. Requires
#          GEMINI_API_KEY and the Supabase pair below. POST /analyses/{id}/rewrites
#          (F5, engine/rewrite/llm.py) also uses GEMINI_API_KEY and always calls the
#          real model, regardless of ENGINE_MODE — so rewrites need the key in mock
#          mode too.
ENGINE_MODE=mock

# Reported by GET /api/health and stamped onto every stored Match, so an
# evaluation result can always be traced back to the code that produced it
# (needed for the frozen v1.0-freeze run in Phase 6).
APP_VERSION=0.1.0

# Artificial delay, in seconds, before a mock analysis completes. Exists so the
# loading states and the progress stepper are exercised honestly rather than
# flashing past. Ignored when ENGINE_MODE=live.
MOCK_DELAY_SECONDS=1.5

# Hard ceiling on resume uploads, in bytes. 5242880 = 5 MB. Must stay in sync
# with the client-side dropzone check in web/ — the browser check is a courtesy,
# this one is the actual limit. Exceeding it returns RESUME_TOO_LARGE.
MAX_UPLOAD_BYTES=5242880

# Overall deadlines and actual running-work limits (per API process).
FETCH_TIMEOUT_SECONDS=15
MAX_CONCURRENT_FETCHES=4
REWRITE_TIMEOUT_SECONDS=60
MAX_CONCURRENT_REWRITES=2

# Startup is separate from the document execution deadline. Memory units are MiB.
PARSER_MEMORY_LIMIT_MB=256
PARSER_STARTUP_TIMEOUT_SECONDS=20
MAX_PDF_DECOMPRESSED_BYTES=10485760
# A 512 MiB instance should use one parser at 192 MiB (see deploy/security-rollout.md).

# Production/Render requires Stripe test billing and disabled simulation.
APP_ENVIRONMENT=local
ALLOW_MOCK_PAYMENTS=false
WEBHOOK_CACHE_MAX_ENTRIES=1000

# Shared rolling minute budgets. Zero blocks work; max 10000.
JOB_REQUESTS_PER_MIN=20
JOB_GLOBAL_REQUESTS_PER_MIN=120
JOB_UNUSED_MAX_ENTRIES=500
JOB_UNUSED_RETENTION_HOURS=24
AUTH_REQUESTS_PER_MIN=120
AUTH_GLOBAL_REQUESTS_PER_MIN=1200
MAX_CONCURRENT_AUTH=4
AUTH_TIMEOUT_SECONDS=5
AUTH_PROVIDER_TIMEOUT_SECONDS=3
AUTH_JWKS_REFRESH_SECONDS=30

# Non-refundable rolling hourly admission limits shared by new live analyses and retries.
# Successful-analysis quotas are separate; failures can refund those quotas but not attempts.
ANALYSIS_ATTEMPTS_PER_HOUR=10
GUEST_ANALYSIS_ATTEMPTS_PER_HOUR=3

# Apply even in mock engine mode: rewrites can call the real AI service.
# These budgets also apply to admins and are not refunded after failures.
REWRITE_ATTEMPTS_PER_HOUR=10
CHECKOUT_ATTEMPTS_PER_HOUR=10
CHECKOUT_CACHE_MAX_ENTRIES=500
# Shared rolling account budget across both checkout status routes (including admins).
# 0 blocks all polling. Bounds: requests 0..10000, cache 1..300s, timeout 1..30s.
CHECKOUT_STATUS_REQUESTS_PER_MIN=30
# Cache both successful lookups and provider failures; webhooks bypass this cache.
CHECKOUT_STATUS_CACHE_SECONDS=5
CHECKOUT_STATUS_PROVIDER_TIMEOUT_SECONDS=10


# ─── Google Gemini (matching, embeddings and F5 rewrites) ──────────────────────
# SECRET. Get one at https://aistudio.google.com/app/apikey
# Only ever read by the FastAPI process. If this string reaches the browser
# bundle, it is compromised — rotate it.
# Not required for analyses while ENGINE_MODE=mock, but rewrites need it in either mode.
GEMINI_API_KEY=your-google-ai-studio-key-here
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: a different model for rewrites only (defaults to GEMINI_MODEL).
# GEMINI_REWRITE_MODEL=


# ─── Supabase (PostgreSQL + pgvector) ──────────────────────────────────────
# Live mode requires a database by default. For intentional single-worker local
# operation without persistence, explicitly set PERSISTENCE_MODE=offline.
# ENGINE_MODE=mock always stays offline, regardless of the credentials below.
PERSISTENCE_MODE=required

# Project URL, from Supabase → Project Settings → API. Not secret on its own,
# but pair it with the key below and it is.
SUPABASE_URL=https://REPLACE_ME.supabase.co

# SECRET. The **service_role** key, not the anon key. It bypasses row-level
# security and has full read/write access to the database. It is only acceptable
# to hold it here because it never leaves the API process: browser → Next.js →
# FastAPI → Supabase. Never put this in Vercel.
SUPABASE_SERVICE_KEY=REPLACE_ME_SERVICE_ROLE_KEY
# Optional legacy HS256 JWT secret (leave empty if using Supabase asymmetric JWKS):
SUPABASE_JWT_SECRET=
# Random salt for hashing guest IPs (1 free guest analysis per 24h):
GUEST_IP_SALT=
# Comma-separated list of trusted proxy IPs or CIDR ranges (e.g. 127.0.0.1,::1,10.0.0.0/8).
# Leave empty (default) so X-Forwarded-For headers are NOT trusted unless the TCP
# connection peer explicitly matches a configured proxy network.
# NOTE: Do not assume hosting providers (Render, Vercel) strip client-supplied
# X-Forwarded-For headers; api/auth.py traverses right-to-left from trusted peers.
TRUSTED_PROXIES=
# Phase 2: Cloudflare Turnstile secret key for server-side guest CAPTCHA verification
# (Use official test key 1x0000000000000000000000000000000AA for local dev):
TURNSTILE_SECRET_KEY=

# ─── Phase 4: Billing (Stripe Sandbox + Mock Fallback) ─────────────────────
# mock | stripe_sandbox
#   mock           — offline demo checkout with "Simulate payment" button
#   stripe_sandbox — Stripe Checkout (requires a test key starting with sk_test_ or rk_test_)
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SITE_URL=http://localhost:3001

# ─── Frontend Supabase Auth & Turnstile (set in web/.env.local and Vercel) ─
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Official test site key: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_CAMPUS_CONTACT_EMAIL=dydavid168@gmail.com
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Optional: Google Search Console HTML verification tag content:
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=


# ─── HTTP / CORS ───────────────────────────────────────────────────────────
# Comma-separated list of browser origins the API will accept cross-origin
# requests from. No trailing slashes; scheme is required.
# Most traffic never needs this — next.config.ts rewrites /api/* server-side, so
# the browser sees a same-origin request — but any direct browser→API fetch does,
# and a wrong value here fails opaquely in the console.
# Local dev covers both spellings of loopback because some browsers normalise
# one to the other. In production this becomes:
#   https://<your-domain>,https://*.vercel.app     (the wildcard covers previews)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ═══════════════════════════════════════════════════════════════════════════
# WEB (Next.js) — set in web/.env.local for local dev, and in Vercel →
# Environment Variables for deployments.
#
# ⚠ EVERY NEXT_PUBLIC_* VARIABLE IS INLINED INTO THE CLIENT BUNDLE AT BUILD
#   TIME AND IS PUBLIC. Anyone can read it with View Source. Never give a
#   NEXT_PUBLIC_ name to anything secret.
# ═══════════════════════════════════════════════════════════════════════════

# Where the Next.js **server** should proxy /api/* to. Read by the rewrite in
# next.config.ts. No trailing slash.
#
# The correct value depends on who is asking, which is the one genuinely
# confusing thing in this stack:
#   local, uvicorn on the host      → http://localhost:8000
#   local, docker compose           → http://api:8000   (Docker DNS, set in
#                                     deploy/docker-compose.yml; a browser cannot
#                                     resolve "api", but only the server uses it)
#   Vercel                          → https://proofit-api.onrender.com
#
# Client-side code should leave this unset and call the relative path /api/...
# so the browser always talks to its own origin. That is why web/Dockerfile
# builds with NEXT_PUBLIC_API_URL="".
NEXT_PUBLIC_API_URL=http://localhost:8000
