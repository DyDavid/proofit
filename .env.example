# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║                                                                           ║
# ║   ⚠  NEVER COMMIT A REAL .env FILE. NEVER PUT A REAL KEY IN THIS FILE.   ║
# ║                                                                           ║
# ║   This is .env.example — a committed TEMPLATE with placeholder values.     ║
# ║   `.env` is listed in .gitignore and must stay there.                      ║
# ║                                                                           ║
# ║   Real values live in exactly two places:                                  ║
# ║     • Render  → Environment          (every API secret)                    ║
# ║     • Vercel  → Environment Variables (NEXT_PUBLIC_API_URL only)           ║
# ║                                                                           ║
# ║   If a key is ever committed: ROTATE IT FIRST, then rewrite history.       ║
# ║   Rotating is the fix; deleting the commit is housekeeping.                ║
# ║                                                                           ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
#
# Usage:
#   cp .env.example .env      # then fill in the real values
#
# Notes on syntax: KEY=value, one per line, no spaces around `=`, no quotes
# unless the value itself contains them, no trailing comments on a value line.
#
# You do NOT need this file to run the local Docker stack —
# `docker compose -f deploy/docker-compose.yml up` runs the API in mock mode with
# everything it needs already set. This file is for running the API directly
# (uvicorn) and as the reference list for what to paste into Render and Vercel.
# See deploy/runbook.md.


# ═══════════════════════════════════════════════════════════════════════════
# API (FastAPI) — server-side only. Nothing in this section may ever be
# prefixed NEXT_PUBLIC_ or referenced from browser code.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Engine ────────────────────────────────────────────────────────────────
# mock | live
#   mock — every analysis returns a fixture from data/fixtures/ after
#          MOCK_DELAY_SECONDS. No LLM calls, no database writes, no keys needed.
#          This is the default for local development and for the demo fallback.
#   live — calls engine.normalize/*, engine.ingest/*, engine.match/*. Requires
#          GEMINI_API_KEY and the Supabase pair below.
ENGINE_MODE=mock

# Reported by GET /api/health and stamped onto every stored Match, so an
# evaluation result can always be traced back to the code that produced it
# (needed for the frozen v1.0-freeze run in Phase 6).
APP_VERSION=0.1.0

# Artificial delay, in seconds, before a mock analysis completes. Exists so the
# loading states and the progress stepper are exercised honestly rather than
# flashing past. Ignored when ENGINE_MODE=live.
MOCK_DELAY_SECONDS=1.5

# Hard ceiling on resume uploads, in bytes. 5242880 = 5 MB. Must stay in sync
# with the client-side dropzone check in web/ — the browser check is a courtesy,
# this one is the actual limit. Exceeding it returns RESUME_TOO_LARGE.
MAX_UPLOAD_BYTES=5242880


# ─── Google Gemini (LLM & Embeddings) ──────────────────────────────────────
# SECRET. Get one at https://aistudio.google.com/app/apikey
# Only ever read by the FastAPI process. If this string reaches the browser
# bundle, it is compromised — rotate it.
# Not required while ENGINE_MODE=mock.
GEMINI_API_KEY=your-google-ai-studio-key-here
GEMINI_MODEL=gemini-3.1-flash-lite


# ─── Supabase (PostgreSQL + pgvector) ──────────────────────────────────────
# Project URL, from Supabase → Project Settings → API. Not secret on its own,
# but pair it with the key below and it is.
SUPABASE_URL=https://REPLACE_ME.supabase.co

# SECRET. The **service_role** key, not the anon key. It bypasses row-level
# security and has full read/write access to the database. It is only acceptable
# to hold it here because it never leaves the API process: browser → Next.js →
# FastAPI → Supabase. Never put this in Vercel.
SUPABASE_SERVICE_KEY=REPLACE_ME_SERVICE_ROLE_KEY


# ─── HTTP / CORS ───────────────────────────────────────────────────────────
# Comma-separated list of browser origins the API will accept cross-origin
# requests from. No trailing slashes; scheme is required.
# Most traffic never needs this — next.config.ts rewrites /api/* server-side, so
# the browser sees a same-origin request — but any direct browser→API fetch does,
# and a wrong value here fails opaquely in the console.
# Local dev covers both spellings of loopback because some browsers normalise
# one to the other. In production this becomes:
#   https://<your-domain>,https://*.vercel.app     (the wildcard covers previews)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ═══════════════════════════════════════════════════════════════════════════
# WEB (Next.js) — set in web/.env.local for local dev, and in Vercel →
# Environment Variables for deployments.
#
# ⚠ EVERY NEXT_PUBLIC_* VARIABLE IS INLINED INTO THE CLIENT BUNDLE AT BUILD
#   TIME AND IS PUBLIC. Anyone can read it with View Source. Never give a
#   NEXT_PUBLIC_ name to anything secret.
# ═══════════════════════════════════════════════════════════════════════════

# Where the Next.js **server** should proxy /api/* to. Read by the rewrite in
# next.config.ts. No trailing slash.
#
# The correct value depends on who is asking, which is the one genuinely
# confusing thing in this stack:
#   local, uvicorn on the host      → http://localhost:8000
#   local, docker compose           → http://api:8000   (Docker DNS, set in
#                                     deploy/docker-compose.yml; a browser cannot
#                                     resolve "api", but only the server uses it)
#   Vercel                          → https://proofit-api.onrender.com
#
# Client-side code should leave this unset and call the relative path /api/...
# so the browser always talks to its own origin. That is why web/Dockerfile
# builds with NEXT_PUBLIC_API_URL="".
NEXT_PUBLIC_API_URL=http://localhost:8000
